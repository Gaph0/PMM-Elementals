<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Custom elemental skin colours. Both parent off Biotech's GeneSkinColorOverride
		(the same abstract base the slime PMM_Skin_SeaFoam used), which carries
		<randomBrightnessFactor>0.18</randomBrightnessFactor>: each carrier's skin is
		randomly brightened/darkened by up to ±18% at generation, so ONE mid-shade base
		colour yields a range of shades across pawns — "various shades of blue/green"
		without needing multiple genes. Biotech-only, like every skin-colour gene.
	-->

	<!-- Undine: a range of watery blues. Mid-base (110, 165, 210) spans roughly
	     (90,135,172) deep water to (130,195,248) pale shallows after the ±18% roll. -->
	<GeneDef ParentName="GeneSkinColorOverride" MayRequire="Ludeon.RimWorld.Biotech">
		<defName>PMM_Skin_UndineBlue</defName>
		<label>undine skin</label>
		<labelShortAdj>undine</labelShortAdj>
		<description>Carriers of this gene have skin in shifting shades of watery blue, from deep-water teal to the pale blue of sunlit shallows.</description>
		<skinColorOverride>(110, 165, 210)</skinColorOverride>
		<displayOrderInCategory>88</displayOrderInCategory>
	</GeneDef>

	<!-- Sylph: a range of light, airy greens. Mid-base (150, 200, 130) spans roughly
	     (123,164,107) leaf to (177,236,153) pale new-growth after the ±18% roll. -->
	<GeneDef ParentName="GeneSkinColorOverride" MayRequire="Ludeon.RimWorld.Biotech">
		<defName>PMM_Skin_SylphGreen</defName>
		<label>sylph skin</label>
		<labelShortAdj>sylph</labelShortAdj>
		<description>Carriers of this gene have skin in shifting shades of light green, from fresh leaf to the pale green of a high sky.</description>
		<skinColorOverride>(150, 200, 130)</skinColorOverride>
		<displayOrderInCategory>88</displayOrderInCategory>
	</GeneDef>

	<!-- Gnome: a range of dirt browns. Mid-base (130, 95, 65) spans roughly
	     (107,78,53) dark loam to (153,112,77) pale dry earth after the ±18% roll. -->
	<GeneDef ParentName="GeneSkinColorOverride" MayRequire="Ludeon.RimWorld.Biotech">
		<defName>PMM_Skin_GnomeBrown</defName>
		<label>gnome skin</label>
		<labelShortAdj>gnome</labelShortAdj>
		<description>Carriers of this gene have skin in shifting shades of earthen brown, from dark loam to pale dry soil.</description>
		<skinColorOverride>(130, 95, 65)</skinColorOverride>
		<displayOrderInCategory>88</displayOrderInCategory>
	</GeneDef>

	<!-- Ignis: a range of flame oranges. Mid-base (235, 130, 50) spans roughly
	     (193,107,41) ember to (255,153,59) bright flame after the ±18% roll. -->
	<GeneDef ParentName="GeneSkinColorOverride" MayRequire="Ludeon.RimWorld.Biotech">
		<defName>PMM_Skin_IgnisOrange</defName>
		<label>ignis skin</label>
		<labelShortAdj>ignis</labelShortAdj>
		<description>Carriers of this gene have skin in shifting shades of flame orange, from smouldering ember to bright blaze.</description>
		<skinColorOverride>(235, 130, 50)</skinColorOverride>
		<displayOrderInCategory>88</displayOrderInCategory>
	</GeneDef>

	<!-- Dorome: a range of clay greys (user ruling 2026-09-01: several shades of clay
	     grey, hair identical to body colour — hair handled by Patch_DoromeHairColor).
	     Mid-base (115, 105, 95) spans roughly (94,86,78) wet riverbed clay to
	     (136,124,112) pale dried clay after the ±18% roll. -->
	<GeneDef ParentName="GeneSkinColorOverride" MayRequire="Ludeon.RimWorld.Biotech">
		<defName>PMM_Skin_DoromeClay</defName>
		<label>dorome skin</label>
		<labelShortAdj>dorome</labelShortAdj>
		<description>Carriers of this gene have skin in shifting shades of clay grey, from wet riverbed clay to pale sun-dried silt.</description>
		<skinColorOverride>(115, 105, 95)</skinColorOverride>
		<displayOrderInCategory>88</displayOrderInCategory>
	</GeneDef>

	<!-- Dorome mud-merge ability gene (locked D11: tamed-only teleport). Grants the
	     PMM_Ability_DoromeMudMerge gizmo; the vanilla ability system enforces the
	     6-hour cooldown. Icon placeholder reuses Biotech's long-jump-legs gene icon. -->
	<GeneDef MayRequire="Ludeon.RimWorld.Biotech">
		<defName>PMM_Gene_DoromeMudMerge</defName>
		<label>mud merge</label>
		<description>Carriers can melt into natural ground and swim through the earth, emerging anywhere on the map. The strain keeps them from merging more than once every few hours.</description>
		<iconPath>UI/Icons/Genes/Gene_LongJumpLegs</iconPath>
		<displayCategory>Ability</displayCategory>
		<abilities>
			<li>PMM_Ability_DoromeMudMerge</li>
		</abilities>
		<descriptionHyperlinks>
			<AbilityDef>PMM_Ability_DoromeMudMerge</AbilityDef>
		</descriptionHyperlinks>
	</GeneDef>

	<!-- Dryad: a range of bark browns (locked D17). Mid-base (120, 95, 70) spans roughly
	     (98,78,57) dark wet bark to (142,112,83) pale sun-bleached wood after the ±18% roll. -->
	<GeneDef ParentName="GeneSkinColorOverride" MayRequire="Ludeon.RimWorld.Biotech">
		<defName>PMM_Skin_DryadBark</defName>
		<label>dryad skin</label>
		<labelShortAdj>dryad</labelShortAdj>
		<description>Carriers of this gene have skin in shifting shades of bark brown, from dark wet bark to pale sun-bleached wood.</description>
		<skinColorOverride>(120, 95, 70)</skinColorOverride>
		<displayOrderInCategory>88</displayOrderInCategory>
	</GeneDef>

	<!-- Genie: a range of dusky desert tans — the bronze of a lamp-dweller's skin.
	     Mid-base (148, 104, 74) spans roughly (121,85,61) deep bronze to
	     (175,123,87) sunlit tan after the ±18% roll. -->
	<GeneDef ParentName="GeneSkinColorOverride" MayRequire="Ludeon.RimWorld.Biotech">
		<defName>PMM_Skin_GenieTan</defName>
		<label>genie skin</label>
		<labelShortAdj>genie</labelShortAdj>
		<description>Carriers of this gene have skin in shifting shades of dusky desert tan, from deep lamp-bronze to sunlit dunes.</description>
		<skinColorOverride>(148, 104, 74)</skinColorOverride>
		<displayOrderInCategory>88</displayOrderInCategory>
	</GeneDef>

	<!-- Genie wish-granting ability gene. Grants the PMM_Ability_GenieWish gizmo:
	     one wish a year for her bonded master, costing nearly all her mana. Icon
	     placeholder reuses Biotech's psychic-bonding gene icon (a bond of service). -->
	<GeneDef MayRequire="Ludeon.RimWorld.Biotech">
		<defName>PMM_Gene_GenieWish</defName>
		<label>wish-granting</label>
		<description>Carriers can grant a wish to the one they are bound to: regrowing a missing limb, erasing an old scar, or lifting a lasting sorrow. A wish takes nearly all of the carrier's mana and cannot be granted more than once a year.</description>
		<iconPath>UI/Icons/Genes/Gene_PsychicBonding</iconPath>
		<displayCategory>Ability</displayCategory>
		<abilities>
			<li>PMM_Ability_GenieWish</li>
		</abilities>
		<descriptionHyperlinks>
			<AbilityDef>PMM_Ability_GenieWish</AbilityDef>
		</descriptionHyperlinks>
	</GeneDef>

	<!-- Apsara: a range of milky creams — her body clad in liquid "like sweet milk"
	     (Apsara wiki entry, locked D-A6). Mid-base (240, 225, 200) spans roughly
	     (197,185,164) warm milk to (255,255,236) fresh cream after the ±18% roll. -->
	<GeneDef ParentName="GeneSkinColorOverride" MayRequire="Ludeon.RimWorld.Biotech">
		<defName>PMM_Skin_ApsaraCream</defName>
		<label>apsara skin</label>
		<labelShortAdj>apsara</labelShortAdj>
		<description>Carriers of this gene have skin in shifting shades of milky cream, from warm milk to fresh, glistening cream.</description>
		<skinColorOverride>(240, 225, 200)</skinColorOverride>
		<displayOrderInCategory>88</displayOrderInCategory>
	</GeneDef>

</Defs>
