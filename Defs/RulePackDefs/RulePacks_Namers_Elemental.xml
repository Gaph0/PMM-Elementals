<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- Person names, e.g. "Terra", "Embra 'Cinder' Vulka" -->
	<RulePackDef>
		<defName>NamerPersonElemental</defName>
		<rulePack>
			<rulesStrings>
				<li>r_name(p=2)->[firstName]</li>
				<li>r_name(p=3)->[firstName] [lastName]</li>
				<li>r_name->[firstName] '[nickName]' [lastName]</li>

				<li>firstName(p=2)->[syl][sylEnd]</li>
				<li>firstName->[syl][syl][sylEnd]</li>

				<li>lastName(p=2)->[syl][sylEnd]</li>
				<li>lastName->[syl][syl][sylEnd]</li>

				<li>nickName->[elementNick]</li>

				<li>syl->Ter</li>
