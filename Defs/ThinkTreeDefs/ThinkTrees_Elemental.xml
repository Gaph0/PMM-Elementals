<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Give the elemental pawn kinds the same wild-man behaviour as vanilla WildMan. The
		vanilla Humanlike think tree only applies MainWildManBehaviorCore + the idle wander
		to pawnKind=WildMan (ThinkNode_ConditionalPawnKind), so an elemental would otherwise
		fall through to the guest branch and immediately JobGiver_ExitMapBest off the map.
		These subtrees are inserted via the Humanlike_PostMain insertTag, mirroring the
		vanilla wild-man branches for the elemental kinds (the exact slime ThinkTrees pattern).

		There is one branch per elemental pawn kind: ThinkNode_ConditionalPawnKind matches the
		pawn's kindDef exactly (it does NOT follow pawn.def / the race, so the race-by-xenotype
		swap is irrelevant here). Every elemental kind must be listed or it will walk straight
		off the map.
			PMM_GnomeWild   = the gnome wander-in (caves)
			PMM_IgnisWild   = the ignis wander-in (hot maps)
			PMM_SylphWild   = the sylph wander-in (high elevation)
			PMM_UndineWild  = the undine wander-in (water tiles)
			PMM_DoromeWild  = the dorome wander-in (caves / rainy swamps)
			PMM_DryadWild   = the dryad wander-in (forest, growing season)
			PMM_ApsaraWild  = the apsara wander-in (water tiles)
			PMM_GenieWild   = the genie (freed from her lamp). Her branch is special:
			  ThinkNode_ConditionalGenieFreedomSpent opens the vanilla JobGiver_ExitMapBest
			  once her freedom timer (PMM_Hediff_GenieFreedom) runs out while she is still
			  factionless - she wanders a few hours enjoying her freedom, THEN leaves.
	-->
	<ThinkTreeDef>
		<defName>PMM_ElementalWildBehavior</defName>
		<insertTag>Humanlike_PostMain</insertTag>
		<thinkRoot Class="ThinkNode_Priority">
			<subNodes>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_GnomeWild</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>MainWildManBehaviorCore</treeDef>
							<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_IgnisWild</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>MainWildManBehaviorCore</treeDef>
							<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_SylphWild</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>MainWildManBehaviorCore</treeDef>
							<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_UndineWild</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>MainWildManBehaviorCore</treeDef>
							<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
						</li>
					</subNodes>
				</li>

			<li Class="ThinkNode_ConditionalPawnKind">
				<pawnKind>PMM_DoromeWild</pawnKind>
				<subNodes>
					<li Class="ThinkNode_Subtree">
						<treeDef>MainWildManBehaviorCore</treeDef>
						<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
					</li>
				</subNodes>
			</li>

			<li Class="ThinkNode_ConditionalPawnKind">
				<pawnKind>PMM_DryadWild</pawnKind>
				<subNodes>
					<li Class="ThinkNode_Subtree">
						<treeDef>MainWildManBehaviorCore</treeDef>
						<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
					</li>
				</subNodes>
			</li>

			<li Class="ThinkNode_ConditionalPawnKind">
				<pawnKind>PMM_ApsaraWild</pawnKind>
				<subNodes>
					<li Class="ThinkNode_Subtree">
						<treeDef>MainWildManBehaviorCore</treeDef>
						<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
					</li>
				</subNodes>
			</li>

			<!-- Genie: while her freedom timer runs she behaves like the other wild
			     elementals; once it is spent (and she is still factionless) she heads
			     for the map edge. The exit branch sits ABOVE the wild-man core so it
			     wins the moment her freedom runs out. -->
			<li Class="ThinkNode_ConditionalPawnKind">
				<pawnKind>PMM_GenieWild</pawnKind>
				<subNodes>
					<li Class="PMM_Elementals.ThinkNode_ConditionalGenieFreedomSpent">
						<subNodes>
							<li Class="JobGiver_ExitMapBest"/>
						</subNodes>
					</li>
					<li Class="ThinkNode_Subtree">
						<treeDef>MainWildManBehaviorCore</treeDef>
						<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
					</li>
				</subNodes>
			</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_GnomeWild</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Tagger">
							<tagToGive>Idle</tagToGive>
							<subNodes>
								<li Class="JobGiver_WanderAnywhere">
									<maxDanger>Deadly</maxDanger>
									<ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
								</li>
							</subNodes>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_IgnisWild</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Tagger">
							<tagToGive>Idle</tagToGive>
							<subNodes>
								<li Class="JobGiver_WanderAnywhere">
									<maxDanger>Deadly</maxDanger>
									<ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
								</li>
							</subNodes>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_SylphWild</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Tagger">
							<tagToGive>Idle</tagToGive>
							<subNodes>
								<li Class="JobGiver_WanderAnywhere">
									<maxDanger>Deadly</maxDanger>
									<ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
								</li>
							</subNodes>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_UndineWild</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Tagger">
							<tagToGive>Idle</tagToGive>
							<subNodes>
								<li Class="JobGiver_WanderAnywhere">
									<maxDanger>Deadly</maxDanger>
									<ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
								</li>
							</subNodes>
						</li>
					</subNodes>
				</li>

			<li Class="ThinkNode_ConditionalPawnKind">
				<pawnKind>PMM_DoromeWild</pawnKind>
				<subNodes>
					<li Class="ThinkNode_Tagger">
						<tagToGive>Idle</tagToGive>
						<subNodes>
							<li Class="JobGiver_WanderAnywhere">
								<maxDanger>Deadly</maxDanger>
								<ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
							</li>
						</subNodes>
					</li>
				</subNodes>
			</li>

			<li Class="ThinkNode_ConditionalPawnKind">
				<pawnKind>PMM_DryadWild</pawnKind>
				<subNodes>
					<li Class="ThinkNode_Tagger">
						<tagToGive>Idle</tagToGive>
						<subNodes>
							<li Class="JobGiver_WanderAnywhere">
								<maxDanger>Deadly</maxDanger>
								<ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
							</li>
						</subNodes>
					</li>
				</subNodes>
			</li>

			<li Class="ThinkNode_ConditionalPawnKind">
				<pawnKind>PMM_ApsaraWild</pawnKind>
				<subNodes>
					<li Class="ThinkNode_Tagger">
						<tagToGive>Idle</tagToGive>
						<subNodes>
							<li Class="JobGiver_WanderAnywhere">
								<maxDanger>Deadly</maxDanger>
								<ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
							</li>
						</subNodes>
					</li>
				</subNodes>
			</li>

			<li Class="ThinkNode_ConditionalPawnKind">
				<pawnKind>PMM_GenieWild</pawnKind>
				<subNodes>
					<li Class="ThinkNode_Tagger">
						<tagToGive>Idle</tagToGive>
						<subNodes>
							<li Class="JobGiver_WanderAnywhere">
								<maxDanger>Deadly</maxDanger>
								<ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
							</li>
						</subNodes>
					</li>
				</subNodes>
			</li>

			</subNodes>
		</thinkRoot>
	</ThinkTreeDef>

</Defs>
