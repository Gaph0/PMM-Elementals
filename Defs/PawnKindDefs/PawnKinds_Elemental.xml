		<apparelIgnorePollution>true</apparelIgnorePollution>
		<combatPower>45</combatPower>
		<initialWillRange>0~4</initialWillRange>
		<initialResistanceRange>4~17</initialResistanceRange>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_ElementalSpawn</li>
					<li>PMM_IgnisSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<xenotypeSet>
			<xenotypeChances>
				<PMM_Elemental_Ignis>100</PMM_Elemental_Ignis>
			</xenotypeChances>
		</xenotypeSet>
	</PawnKindDef>

