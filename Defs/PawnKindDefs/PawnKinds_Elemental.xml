	<!--
		Apsara: wanders in only on tiles with water (PMM_ApsaraWandersIn incident, same
		gate as the undine). combatPower 40 — a lover, not a fighter. Same Water terrain
		move-speed factor as the undine: she glides through water like any water
		elemental; her MoveSpeed_Slow gene multiplies it down (~2.13 in water vs the
		undine's 2.5), the "slightly slower than an undine" of locked D-A6.
	-->
	<PawnKindDef>
		<defName>PMM_Elemental_Apsara</defName>
