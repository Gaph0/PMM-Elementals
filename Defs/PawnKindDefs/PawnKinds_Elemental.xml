					<li>PMM_ElementalSpawn</li>
					<li>PMM_GenieSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<xenotypeSet>
			<xenotypeChances>
				<PMM_Elemental_Genie>100</PMM_Elemental_Genie>
			</xenotypeChances>
		</xenotypeSet>
	</PawnKindDef>

	<!--
		Undine: wanders in only on tiles with water (PMM_UndineWandersIn incident).
		The Water terrain move-speed factor gives her the undine's glide through water
		(sea-slime precedent: vanilla coastal animals use 2.0; she gets 2.5). Read by
		the vanilla StatPart_TerrainMoveSpeed on the MoveSpeed stat.
	-->
	<PawnKindDef>
		<defName>PMM_Elemental_Undine</defName>
		<label>undine</label>
		<race>PMM_Race_UndineMomo</race>
		<fixedGender>Female</fixedGender>
		<maxGenerationAge>60</maxGenerationAge>
		<chemicalAddictionChance>0</chemicalAddictionChance>
		<apparelIgnorePollution>true</apparelIgnorePollution>
		<combatPower>45</combatPower>
		<initialWillRange>0~4</initialWillRange>
		<initialResistanceRange>4~17</initialResistanceRange>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_ElementalSpawn</li>
					<li>PMM_UndineSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<moveSpeedFactorByTerrainTag>
			<li>
				<key>Water</key>
				<value>2.5</value>
			</li>
		</moveSpeedFactorByTerrainTag>
		<xenotypeSet>
			<xenotypeChances>
				<PMM_Elemental_Undine>100</PMM_Elemental_Undine>
			</xenotypeChances>
		</xenotypeSet>
	</PawnKindDef>

	<!--
		Dorome: wanders in only on cave maps or rainy swamps (PMM_DoromeWandersIn
		incident, locked D9). combatPower 40 — sluggish and simple, the least
		threatening elemental. No moveSpeedFactorByTerrainTag: Mud/MarshySoil carry no
		terrainTags in Core, so there is no mud analogue to the undine's Water key.
	-->
	<PawnKindDef>
		<defName>PMM_Elemental_Dorome</defName>
		<label>dorome</label>
		<race>PMM_Race_DoromeMomo</race>
		<fixedGender>Female</fixedGender>
