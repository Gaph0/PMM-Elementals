	<!--
		Genie: never wanders in — she arrives sealed in the Old Dusty Lamp
		(PMM_GenieLampFound incident) and is generated when a colonist cleans it. The
		kind exists for that spawn; the wild-man patches treat her like the other
		elementals while her join offer waits for an answer.
	-->
	<PawnKindDef>
		<defName>PMM_Elemental_Genie</defName>
		<label>genie</label>
		<race>PMM_Race_GenieMomo</race>
		<fixedGender>Female</fixedGender>
		<maxGenerationAge>60</maxGenerationAge>
		<chemicalAddictionChance>0</chemicalAddictionChance>
		<apparelIgnorePollution>true</apparelIgnorePollution>
		<combatPower>45</combatPower>
