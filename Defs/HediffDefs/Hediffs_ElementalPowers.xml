<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Elemental power hediffs. A pawn's RACE-def <comps> are never instantiated (see
		ElementalPowers.cs), but a HEDIFF's comps do instantiate and tick — the slime
		mod's jelly-ooze uses the same mechanism.

		The gnome, sylph and dryad powers no longer need a hediff of their own: their
		HediffComps now sit on those three race trackers (Race_ElementalMomo.xml), which
		removes a Health-tab row per pawn and lets a transformed woman inherit the power.
		Only the undine one remains here, because it is added and removed with the
		weather and a race tracker is permanent. The apsara and genie state hediffs live
		in their own files.
	-->

	<!--
		Undine wet-weather speed (hidden): maintained by MapComponent_UndineWetSpeed while
		it rains or snows. The MoveSpeed offset makes her glide faster in wet weather.
	-->
	<HediffDef>
		<defName>PMM_Hediff_UndineWetSpeed</defName>
		<label>in her element</label>
		<description>The undine moves with effortless grace through the rain.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<isBad>false</isBad>
		<initialSeverity>1</initialSeverity>
		<maxSeverity>1</maxSeverity>
		<everCurableByItem>false</everCurableByItem>
		<stages>
			<li>
				<minSeverity>0</minSeverity>
				<statOffsets>
					<MoveSpeed>1.0</MoveSpeed>
				</statOffsets>
			</li>
		</stages>
	</HediffDef>

</Defs>
